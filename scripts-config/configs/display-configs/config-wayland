#exec --no-startup-id "gnome-keyring-daemon --components=secrets"

# - - - use this for lock/hibernate on wayland
# screenlock and suspend (wayland)
# uses `nslock`, our wrapper around `swaylock`
exec swayidle -w \
    timeout 900 'nslock &' \
    timeout 1200 'systemctl suspend' \
    before-sleep 'nslock' 

# The combination of xss-lock, nm-applet and pactl is a popular choice, so
# they are included here as an example. Modify as you see fit.

# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
#exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -c 000000 --nofork

# standardizing on waybar (wayland), so this section is legacy - we have built in volume controls on waybar.
# volumeicon provides us a simple, GUI way to control volume with mouse
# (volumeicon on arch/ubuntu/deb.)
# (if using pipewire, use pasystray.)
#exec --no-startup-id volumeicon
# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
# polybar has built in volume controls. don't worry about the above if using polybar.

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
#exec --no-startup-id nm-applet

# Blueman (bluetooth-manager) is used to handle Bluetooth connections.
# We use `blueman-applet` to display the BT status in the bar.
exec --no-startup-id sh -c "sleep 1 && blueman-applet &"

# we currently use dunst to handle system notifications.
# make sure it starts on launch, because apps that rely on notifications might hang.
exec --no-startup-id dunst

# we use nitrogen for wallpaper management.
# autostart nitrogen for the wallpaper.
# we should make a command for a default wallpaper.
#exec --no-startup-id nitrogen --restore

# we use `meteo-qt` for keeping tabs on the weather.
# it displays a small widget showing weather in the panel.
# you can click the widget to pop out a window with forecast.
# You can edit your City and the widget by right-clicking it, and selecting 'settings.'
exec_always --no-startup-id sh -c "sleep 1 && meteo-qt &"

# we use Flameshot for easily taking screenshots from the panel (legacy - we're using `grimshot` these days).
#exec_always --no-startup-id sh -c "sleep 1 && flameshot &"

# we use lxpolkit to handle priv escalation when needed.
exec --no-startup-id lxpolkit

# start compositor
#exec --no-startup-id xcompmgr
