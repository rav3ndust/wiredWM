# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status && notify-send "wired helper" "volume +10"
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status && notify-send "wired helper" "volume -10"
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status && notify-send "wired helper" "volume muted"
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal.
# Our installed terminal emulators are "sakura", "foot", "ghostty", "st", "gnome-terminal", "mate-terminal", "kitty" and "alacritty."
# Choose which one works best for you!
#bindsym $mod+Return exec sakura
bindsym $mod+Return exec foot
#bindsym $mod+Return exec st
#bindsym $mod+Return exec kitty
#bindsym $mod+Return exec alacritty
#bindsym $mod+Return exec gnome-terminal
#bindsym $mod+Return exec mate-terminal

# kill focused window
bindsym $mod+Shift+q kill

# start applications and run commands (your choice of dmenu or rofi)
# start dmenu (a program launcher) - nightshade customized dmenu
bindsym $mod+d exec dmenu_run -fn "NotoSans-10" -nb black -nf pink -sb green -sf red -p "nightshade - run command: "
# rofi version of the above
#bindsym $mod+d exec --no-startup-id "rofi -show run -theme purple -font 'Quicksand Bold 10'"
# There also is the (new) i3-dmenu-desktop which only displays applications
# shipping a .desktop file. It is a wrapper around dmenu, so you need that
# installed.
bindsym $mod+Shift+a exec --no-startup-id i3-dmenu-desktop --dmenu='dmenu -fn "NotoSans-10" -i -nb black -nf pink -sb green -sf red -p "nightshade - Applications List: "'
# rofi version of the above.
#bindsym $mod+Shift+a exec --no-startup-id "rofi -show drun -theme purple -font 'Inter Bold 10'"

#optional alternative:
# i3-dmenu-desktop (rofi)...
#bindsym $mod+Shift+a exec --no-startup-id "i3-dmenu-desktop --dmenu='rofi -dmenu'"

# launch rofi - autorun, ssh, app picker.
bindsym $mod+Tab exec --no-startup-id "rofi -show combi drun,run"
#bindsym $mod+Shift+d exec --no-startup-id "rofi -combi -modi window,drun,run -theme purple -font 'Inter Bold 10' -show combi"
