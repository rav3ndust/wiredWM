# wired config
# this file won't be overwritten, so feel free to edit it as you see fit!
# for reference, please see these links: 
#	- https://rav3ndust.xyz/wiki/wiredWM.html
#	- https://github.com/rav3ndust/wiredWM
#	- https://codeberg.org/rav3ndust/wiredWM
# Note that in this config, "$mod" is the 'super' key, while "Mod1' is the 'alt' key
set $mod Mod4

# - - - this is sway specific: - - -
# XXX it is also being tested, so comment it out when not using it.
# ensure some paths are properly linked
#exec --no-startup-id bash -c 'export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:$HOME/.local/bin:$PATH"'
# import environment
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway
# set secret store. we use gnome-keyring. a gui to see its content can be called via `seahorse`
exec --no-startup-id "gnome-keyring-daemon --components=secrets"
# handle some imports
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK PATH
exec_always --no-startup-id systemctl --user set-environment PATH="/usr/games:$HOME/.local/bin:$PATH"
# set wallpaper
exec swaybg -i $HOME/wiredWM/wp/synthwavelain.jpeg
#exec swaybg -i $HOME/wiredWM/wp/lain4.png &

# make windows float or tile by default.
# comment/uncomment the below line to disable/enable tiling by default.
#for_window [class="[.]*"] floating enable

# - - for window title bars - -
# (for no titlebars (except when windows are tabbed/stacked)):
for_window [class="^.*"] border pixel 4
# (for always-on titlebars:
#for_window [class="^.*"] border normal 4
# > select which option for borders you want by commenting the appropriate options out

# - - for gaps - -
#####################################
# - - smart gaps/borders.
smart_gaps on
smart_borders on
# - - manual gaps.
# You can manually adjust their values below, if you choose to set them.
gaps inner 3
#gaps inner 7
gaps outer 3

#for_window [class=".*"] border pixel 2 gaps inner 50 gaps outer 20

# for border colors
# the final hex code is window border. currently = Neon Pink (#FF10F0)
client.focused 		#ff10f0   #000000    #39FF14  #39FF14  #FF10F0
client.unfocused 	#000000   #000000    #ff3131
#              		border   background   text     indic   child_border
