// -*- mode: json -*-
// waybar config for wiredWM
//	- by rav3ndust
// this file should also live at /etc/xdg/waybar/config
{
	"layer": "top",
	"position": "top",

	"modules-left": [
		"sway/workspaces",
		"sway/window"
	],
	"modules-center": [
		"clock#1",
		"clock#2",
		"clock#3"
	],
	"modules-right": [
		"pulseaudio",
		//"memory",
		//"cpu",
		"network",
		"battery",
		//"disk",
		"tray"
	],

	"sway/workspaces": {
		"disable-scroll": false,
		"format": "{name}"
	},

	"clock#1": {
		"format": "{:%a}",
		"tooltip": false,
		"on-click": "st -e calcurse"
	},
	"clock#2": {
		"format": "{:%H:%M}",
		"tooltip": false,
		"on-click": "st -e tty-clock"
	},
	"clock#3": {
		"format": "{:%Y/%m/%d}",
		"tooltip": true,
		"on-click": "gsimplecal"
	},

	"pulseaudio": {
		"format": "🔊 {volume:2}%",  // Added volume character
		"format-bluetooth": "🔊 Volume {volume}% ",
		"format-muted": "🔇 mute",  // Added mute character
		"format-icons": {
			"headphones": "🎧",
			"default": [
				"🔊",
				"🔈"
			]
		},
		"scroll-step": 5,
		"on-click": "pamixer -t",
		"on-click-right": "pavucontrol"
	},
	// - - - XXX testing section XXX - - - 
	// this is a 'testing' network module. if it doesn't work out right, we'll remove it
	"network": {
        	"format-wifi": "📶 {essid} ({signalStrength}%)",
        	"format-ethernet": "🌐 {ifname}",
        	"format-disconnected": "⚠ Disconnected",
        	"tooltip-format": "Wireless status -  {ifname}: {ipaddr}/{cidr}",
        	"on-click": "st -e nmtui",
        	"interval": 5
    	},
	// - - - XXX end testing section XXX - - - 
	"memory": {
		"interval": 5,
		"format": "Mem {}%"
	},
	"cpu": {
		"interval": 5,
		"format": "CPU {usage:2}%"
	},
	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		]
	},
	"disk": {
		"interval": 5,
		"format": "Disk {percentage_used:2}%",
		"path": "/"
	},
	"tray": {
		"icon-size": 20 
	}
}

