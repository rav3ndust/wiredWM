// -*- mode: json -*-
// waybar config for wiredWM
//	- by rav3ndust
// this file should also live at /etc/xdg/waybar/config
{
    "layer": "top",
    "position": "top",

    "modules-left": [
        "custom/wired-launcher",
        "sway/workspaces",
        "sway/window"
    ],
    "modules-center": [
        "clock#1",
        "clock#2",
        "clock#3"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        //"power-profiles-daemon",
        "backlight",
        //"idle_inhibitor",
        "tray",
        "custom/power"
    ],

    "sway/workspaces": {
        "disable-scroll": false,
        "format": "{name}"
    },

    "clock#1": {
        "format": "{:%a}",
        "tooltip": false,
        "on-click": "foot -e calcurse"
    },
    "clock#2": {
        "format": "{:%H:%M}",
        "tooltip": false,
        "on-click": "foot -e tty-clock"
    },
    "clock#3": {
        "format": "{:%Y/%m/%d}",
        "tooltip": false, 
        "on-click": "gsimplecal"
    },

    "pulseaudio": {
        "format": "🔊 {volume:2}%",  // Added volume character
        "format-bluetooth": "🔊 Volume {volume}% ",
        "format-muted": "🔇 mute",  // Added mute character
        "format-icons": {
            "headphones": "🎧",
            "default": [
                "🔊",
                "🔈"
            ]
        },
        "scroll-step": 5,
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol"
    },
    // - - - XXX testing section XXX - - - 
    // this is a 'testing' network module. if it doesn't work out right, we'll remove it
    "network": {
            "format-wifi": "📶 {signalStrength}%",
            "format-ethernet": "🌐 {ifname}",
            "format-disconnected": "⚠ Disconnected",
            "tooltip-format": "Wireless status -  {ifname}: {ipaddr}/{cidr}",
	   "tooltip-format-wifi": "{essid}",
            "on-click": "foot -e nmtui",
            "interval": 5
        },
    // - - - XXX end testing section XXX - - - 
    "memory": {
        "interval": 5,
        "format": "Mem {}%"
    },
    "cpu": {
        "interval": 5,
        "format": "CPU {usage:2}%"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "disk": {
        "interval": 5,
        "format": "Disk {percentage_used:2}%",
        "path": "/"
    },
    "tray": {
        "icon-size": 20 
    },
    "custom/wired-launcher": {
        "format": "▽",
        "on-click": "rofi -show combi -combi -modi window,drun,run modi combi",
        "tooltip": true,
	"tooltip-format": "open Wired launcher"	
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "backlight": {
        "format": "{percent}% {icon}",
	"tooltip": true,
	"tooltip-format": "Brightness control",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "custom/power": {
        "format" : "⏻ ",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/usr/share/waybar/custom_modules/power_menu.xml",
        "menu-actions": {
            "shutdown": "sh -c 'systemctl poweroff'",
            "reboot": "reboot",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate"
        }
    }
}
