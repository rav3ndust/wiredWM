# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 5
	markup = "pango" 
}

#order += "ipv6"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
#order += "disk /"
#order += "load"
#order += "memory"
order += "tztime local"

# = = = = = 

wireless _first_ {
        format_up = "wireless: %essid"
        format_down = "wireless: down"
}

ethernet _first_ {
        format_up = "ethernet: %essid"
        format_down = "ethernet: down"
}

battery all {
        #format = "🔋 %status %percentage %remaining"
	format = " <span color='#ff10f0'>%status %percentage</span> "  
}

#disk "/" {
#        format = "%avail"
#}

#load {
#        format = "%1min"
#}

#memory {
#        format = "Memory: %used | %available"
#        threshold_degraded = "1G"
#        format_degraded = "MEMORY < %available"
#}

tztime local {
        # use this option for 12-hour time format
        #format = "<span color='#ff9cce'> %a, %b %d %Y   %l:%M %P</span>  "
	# use this option for 24-hour time format
	format = "<span color='#ff9cce'> %a, %b %d %Y   %H:%M</span>  "
}
